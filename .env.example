# Firebase config cho chế độ chơi online (mã phòng).
# Sao chép file này thành .env.local rồi điền giá trị từ Firebase Console
# (Project settings → General → Your apps → firebaseConfig).
# .env.local đã được .gitignore bỏ qua nên không lộ lên git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key (Google AI Studio) cho chatbot thảo luận KTCT Mác–Lênin.
# Lấy key tại https://aistudio.google.com/apikey — không commit file .env.local.
VITE_GEMINI_API_KEY=
